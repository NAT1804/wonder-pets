# Copy this file to docker/.env.prod on your VPS and fill in strong secrets

# PostgreSQL
APP_DB_NAME=appdata
APP_DB_USER=appuser
APP_DB_PASSWORD=replace_with_strong_db_password

# API & Auth
API_PORT=3000
CORS_ORIGINS=https://wonderpets.vn,https://www.wonderpets.vn
SWAGGER_ENABLED=false
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_SECURE=true

# Cloudflare R2 (optional until image upload is enabled)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=wonder-pets-media
R2_PUBLIC_BASE_URL=https://media.wonderpets.vn
