# Copy this file to .env for local API development

NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200
SWAGGER_ENABLED=true

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://appuser:change_me_app_db_password@localhost:5433/appdata?schema=public

# Self-hosted NestJS Auth (JWT + httpOnly Refresh Cookie)
# In production, generate a strong random secret (>= 32 chars), e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=dev-only-change-me-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_SECURE=false

# Cloudflare R2 (optional in local dev; required for image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=wonder-pets-media
R2_PUBLIC_BASE_URL=https://media.wonderpets.vn

# Keycloak OIDC (optional - kept for self-study/research)
KEYCLOAK_ISSUER=http://localhost:8080/realms/pets-shop-realm
